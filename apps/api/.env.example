DATABASE_URL="postgresql://kalusmart_app:replace-me@localhost:5432/kalusmart_trade?schema=public"
PORT=4000
WEB_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
COOKIE_SECURE=false        # set true when served over HTTPS
UPLOAD_DIR=./uploads       # product images and 3D models are stored here (outside the web root)
PLATFORM_FEE_PERCENT=0     # platform fee on each sale, 0 to 100, up to 2 decimals. Set the agreed rate here.

AI_SERVICE_TOKEN=change-me-to-a-long-random-string
NODE_ENV=development
COOKIE_SECURE=false
ENABLE_SWAGGER=true
TRUST_PROXY=false
AI_SEND_BUSINESS_CONTEXT=true

# Phase 3.5: payment provider verification. Placeholders only. Fill values in .env, never in chat or code.
# Telebirr is not connected until its merchant credentials and API documentation are supplied.
TELEBIRR_BASE_URL=
TELEBIRR_APP_ID=
TELEBIRR_PUBLIC_KEY=
PAYMENT_PROVIDER_TIMEOUT_MS=8000   # 1000 to 60000. A slow provider counts as UNAVAILABLE, never as verified.

# Phase 4: reporting. Business-day offset from UTC in minutes (180 = UTC+3, Ethiopia). Ranges are inclusive by local day.
REPORT_UTC_OFFSET_MINUTES=180

# Google sign-in (OpenID Connect). Leave empty to keep it disabled. Create the OAuth client in Google Cloud Console.
# The redirect URI must match exactly what is registered there. Never commit the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
