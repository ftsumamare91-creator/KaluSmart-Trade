generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  audits           AuditEvent[]
  BusinessDocument BusinessDocument[]
  categories       Category[]
  customers        Customer[]
  expenses         Expense[]
  members          Membership[]
  payments         Payment[]
  paymentVerificationAttempts PaymentVerificationAttempt[]
  suppliers        Supplier[]
  purchases        Purchase[]
  stockMovements   StockMovement[]
  supplierPayments SupplierPayment[]
  products         Product[]
  sales            Sale[]
  sessions         Session[]
  workflows        Workflow[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  fullName     String
  createdAt    DateTime     @default(now())
  emailVerifiedAt DateTime?
  auditEvents  AuditEvent[]
  memberships  Membership[]
  sessions     Session[]
  authTokens   AuthToken[]
}

model Session {
  id             String       @id @default(cuid())
  tokenHash      String       @unique
  userId         String
  organizationId String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           UserRole     @default(EMPLOYEE)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales          Sale[]

  @@index([organizationId, createdAt])
  @@index([organizationId, email])
}

model Product {
  id                  String       @id @default(cuid())
  organizationId      String
  categoryId          String?
  sku                 String
  name                String
  description         String?
  unitPrice           Decimal      @db.Decimal(14, 2)
  quantity            Int          @default(0)
  reorderLevel        Int          @default(5)
  imageUrl            String?
  model3dUrl          String?
  manufacturer        String?
  manufacturerAddress String?
  qualityGrade        String?
  productionDate      DateTime?
  expiryDate          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category            Category?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  saleItems           SaleItem[]
  purchaseItems       PurchaseItem[]
  stockMovements      StockMovement[]

  @@unique([organizationId, sku])
  @@index([organizationId, quantity])
  @@index([organizationId, categoryId])
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  parentId       String?
  slug           String
  nameAm         String
  nameEn         String?
  nameOm         String?
  nameTi         String?
  description    String?
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[]   @relation("CategoryTree")
  products       Product[]

  @@unique([organizationId, parentId, slug])
  @@index([organizationId, parentId, sortOrder])
}

model Sale {
  id             String       @id @default(cuid())
  organizationId String
  reference      String
  status         SaleStatus   @default(DRAFT)
  total          Decimal      @db.Decimal(14, 2)
  /** Platform fee: the percent in force when the sale was made, the fee charged, and what remains. */
  feePercent     Decimal      @default(0) @db.Decimal(5, 2)
  feeAmount      Decimal      @default(0) @db.Decimal(14, 2)
  netAmount      Decimal      @default(0) @db.Decimal(14, 2)
  customerName   String?
  /** Set only when the sale is linked to a known customer. Walk-in sales keep this NULL. */
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /** Client-supplied key so a retried submission does not create a second sale. */
  idempotencyKey String?
  notes          String?
  soldAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          SaleItem[]
  payments       Payment[]
  stockMovements StockMovement[]

  @@index([organizationId, customerId])
  @@unique([organizationId, reference])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, soldAt])
}

model Payment {
  id                String        @id @default(cuid())
  organizationId    String
  saleId            String
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(14, 2)
  /** Telebirr transaction number or bank transfer reference from the receipt. */
  providerReference String?
  payerName         String?
  payerPhone        String?
  bankName          String?
  recordedById      String?
  confirmedById     String?
  /** Decision time: when the payment was confirmed or rejected (also the verification result time). */
  confirmedAt       DateTime?
  /** How the CONFIRMED decision was reached. NULL while pending or rejected. */
  verificationMethod VerificationMethod?
  /** Only set from a trusted provider lookup. Manual decisions leave these NULL. */
  verifiedAmount    Decimal?      @db.Decimal(14, 2)
  verifiedCurrency  String?       @db.VarChar(3)
  /** Provider's own transaction ID. Unique per organization and method, so one provider transaction credits one payment. */
  providerTransactionId String?   @db.VarChar(80)
  createdAt         DateTime      @default(now())
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale              Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  verificationAttempts PaymentVerificationAttempt[]

  /** The same receipt cannot be recorded twice. Cash has no reference, so NULLs do not collide. */
  @@unique([organizationId, method, providerReference])
  /** One provider transaction cannot be credited to two payments. */
  @@unique([organizationId, method, providerTransactionId])
  @@index([saleId, status])
}

/// One row per verification try (provider lookup or manual review decision). Never holds secrets.
model PaymentVerificationAttempt {
  id             String                       @id @default(cuid())
  organizationId String
  paymentId      String
  kind           VerificationAttemptKind
  outcome        VerificationAttemptOutcome
  /** Stable machine code such as PROVIDER_TIMEOUT or AMOUNT_MISMATCH. Never a raw provider message. */
  errorCode      String?                      @db.VarChar(60)
  requestedById  String?
  startedAt      DateTime                     @default(now())
  finishedAt     DateTime                     @default(now())
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment        Payment                      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, startedAt])
  @@index([organizationId, startedAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(14, 2)
  lineTotal Decimal @db.Decimal(14, 2)
  product   Product @relation(fields: [productId], references: [id])
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Expense {
  id             String        @id @default(cuid())
  organizationId String
  category       String
  description    String
  amount         Decimal       @db.Decimal(14, 2)
  spentAt        DateTime      @default(now())
  /** Optional: how the expense was paid. Reuses the payment method list. */
  paymentMethod  PaymentMethod?
  reference      String?       @db.VarChar(80)
  /** Expenses are voided, never deleted, so the history stays complete. */
  status         ExpenseStatus @default(ACTIVE)
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?       @db.VarChar(200)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, spentAt])
  @@index([organizationId, status, spentAt])
  @@index([organizationId, category])
}

enum ExpenseStatus {
  ACTIVE
  VOIDED
}

/** A supplier you buy stock from. Kept apart from customers. */
model Supplier {
  id             String            @id @default(cuid())
  organizationId String
  name           String            @db.VarChar(120)
  phone          String?           @db.VarChar(20)
  email          String?           @db.VarChar(120)
  address        String?           @db.VarChar(200)
  notes          String?           @db.VarChar(500)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchases      Purchase[]
  supplierPayments SupplierPayment[]

  @@index([organizationId, name])
  @@index([organizationId, isActive])
}

/** Stock bought from a supplier. Stock increases only when it is RECEIVED. Unit costs are kept per line. */
model Purchase {
  id                String         @id @default(cuid())
  organizationId    String
  supplierId        String
  /** Our own number (P-...), generated by the server. */
  reference         String         @db.VarChar(40)
  /** The supplier's invoice number, as printed on their document. */
  supplierReference String?        @db.VarChar(80)
  status            PurchaseStatus @default(DRAFT)
  total             Decimal        @default(0) @db.Decimal(14, 2)
  notes             String?        @db.VarChar(500)
  purchasedAt       DateTime       @default(now())
  idempotencyKey    String?        @db.VarChar(64)
  createdById       String?
  receivedAt        DateTime?
  receivedById      String?
  cancelledAt       DateTime?
  cancelledById     String?
  cancelReason      String?        @db.VarChar(200)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier          Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items             PurchaseItem[]
  supplierPayments  SupplierPayment[]
  stockMovements    StockMovement[]

  @@unique([organizationId, reference])
  @@unique([organizationId, idempotencyKey])
  /** The same supplier invoice cannot be entered twice. Drafts without an invoice number do not collide. */
  @@unique([organizationId, supplierId, supplierReference])
  @@index([organizationId, status, purchasedAt])
  @@index([supplierId])
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Int
  /** Historical cost for this purchase. Never changed by later price edits on the product. */
  unitCost   Decimal  @db.Decimal(14, 2)
  lineTotal  Decimal  @db.Decimal(14, 2)
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([productId])
}

/** Every change to Product.quantity writes one row here, in the same transaction. */
model StockMovement {
  id             String        @id @default(cuid())
  organizationId String
  productId      String
  delta          Int
  quantityAfter  Int
  reason         StockReason
  purchaseId     String?
  saleId         String?
  note           String?       @db.VarChar(200)
  createdById    String?
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchase       Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  sale           Sale?         @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([organizationId, productId, createdAt])
  @@index([purchaseId])
  @@index([saleId])
}

enum StockReason {
  SALE
  PURCHASE_RECEIPT
  PURCHASE_REVERSAL
  ADJUSTMENT
}

/** Money paid to a supplier against one received purchase. Same status vocabulary as customer payments. */
model SupplierPayment {
  id             String        @id @default(cuid())
  organizationId String
  supplierId     String
  purchaseId     String
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(14, 2)
  reference      String?       @db.VarChar(80)
  recordedById   String?
  confirmedById  String?
  confirmedAt    DateTime?
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchase       Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@unique([organizationId, method, reference])
  @@index([purchaseId, status])
  @@index([supplierId, status])
}

model Workflow {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  triggerType    String
  config         Json
  status         WorkflowStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  details        Json?
  ipAddress      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
}

model BusinessDocument {
  id             String         @id @default(cuid())
  organizationId String
  title          String
  mimeType       String
  storageKey     String         // server-generated, never returned to clients
  extractedText  String?        // legacy column, not written by Phase 6
  // Phase 6 fields
  category       String         @default("OTHER") // RECEIPT | INVOICE | CONTRACT | OTHER
  status         DocumentStatus @default(UPLOADED)
  sizeBytes      Int?
  sha256         String?       // null only for rows created before Phase 6
  uploadedById   String?        // from the validated session only; no FK so user deletion never blocks audit
  linkedType     String?        // SALE | EXPENSE | PURCHASE | SUPPLIER | CUSTOMER (validated in the API)
  linkedId       String?
  extractedFields Json?         // UNVERIFIED model output, sanitised; never a financial record
  processingError String?       // safe, fixed messages only
  reviewDecision String?        // CONFIRMED | REJECTED, set by a human reviewer
  reviewedById   String?
  reviewedAt     DateTime?
  archivedAt     DateTime?      // archive only; files are kept for audit and retention
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  Organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sha256])
  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, category])
  @@index([organizationId, linkedType, linkedId])
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
  REVIEW_REQUIRED
}

enum UserRole {
  ADMIN
  MANAGER
  ACCOUNTANT
  EMPLOYEE
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  TELEBIRR
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  /** A provider definitively refused the payment (amount or currency mismatch, invalid transaction). Terminal. */
  FAILED
}

enum VerificationMethod {
  MANUAL
  PROVIDER
}

enum VerificationAttemptKind {
  PROVIDER_CHECK
  MANUAL_REVIEW
}

enum VerificationAttemptOutcome {
  VERIFIED
  REJECTED
  FAILED
  NOT_FOUND
  UNAVAILABLE
}

enum WorkflowStatus {
  ACTIVE
  PAUSED
}

/// One-time links for email verification and password reset. Only the SHA-256 hash of the token is stored.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}
