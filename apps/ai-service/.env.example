# Choose ONE provider. Keep AI_PROVIDER=disabled until you have a key.
AI_PROVIDER=disabled                 # openai | gemini | openai_compatible | disabled

# ChatGPT (OpenAI): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (Google AI Studio): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Any other OpenAI-compatible service
COMPAT_API_KEY=
COMPAT_MODEL=
COMPAT_BASE_URL=

AI_TIMEOUT_SECONDS=90
AI_MAX_TOKENS=900
AI_CORS_ORIGINS=http://localhost:3000

AI_SERVICE_TOKEN=change-me-to-a-long-random-string
